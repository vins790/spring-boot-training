<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-1" author="system">
        <comment>Create archived_scores table</comment>
        <createTable tableName="archived_scores">
            <column name="archive_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="timestamp" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="leaderboard" type="JSON">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex tableName="archived_scores" indexName="idx_archived_scores_timestamp">
            <column name="timestamp"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
