<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-1" author="system">
        <comment>Create users table</comment>
        <createTable tableName="users">
            <column name="user_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="users" indexName="idx_username">
            <column name="username"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-2" author="system">
        <comment>Create sentences table</comment>
        <createTable tableName="sentences">
            <column name="sentence_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sentence" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="sentences"
            baseColumnNames="user_id"
            constraintName="fk_sentences_user"
            referencedTableName="users"
            referencedColumnNames="user_id"
            onDelete="CASCADE"/>
        <createIndex tableName="sentences" indexName="idx_sentences_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="sentences" indexName="idx_sentences_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-3" author="system">
        <comment>Create words table</comment>
        <createTable tableName="words">
            <column name="word_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="word" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="sentence_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="words"
            baseColumnNames="sentence_id"
            constraintName="fk_words_sentence"
            referencedTableName="sentences"
            referencedColumnNames="sentence_id"
            onDelete="CASCADE"/>
        <createIndex tableName="words" indexName="idx_words_word">
            <column name="word"/>
        </createIndex>
        <createIndex tableName="words" indexName="idx_words_sentence_id">
            <column name="sentence_id"/>
        </createIndex>
        <createIndex tableName="words" indexName="idx_words_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-4" author="system">
        <comment>Create user_words join table</comment>
        <createTable tableName="user_words">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="word_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey
            tableName="user_words"
            columnNames="user_id, word_id"
            constraintName="pk_user_words"/>
        <addForeignKeyConstraint
            baseTableName="user_words"
            baseColumnNames="user_id"
            constraintName="fk_user_words_user"
            referencedTableName="users"
            referencedColumnNames="user_id"
            onDelete="CASCADE"/>
        <addForeignKeyConstraint
            baseTableName="user_words"
            baseColumnNames="word_id"
            constraintName="fk_user_words_word"
            referencedTableName="words"
            referencedColumnNames="word_id"
            onDelete="CASCADE"/>
        <createIndex tableName="user_words" indexName="idx_user_words_word_id">
            <column name="word_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-5" author="system">
        <comment>Create score table</comment>
        <createTable tableName="score">
            <column name="user_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="score" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="score"
            baseColumnNames="user_id"
            constraintName="fk_score_user"
            referencedTableName="users"
            referencedColumnNames="user_id"
            onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
